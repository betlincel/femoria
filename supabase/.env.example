# Edge Function gizli anahtarları (yerel: `npm run functions:serve`)
# Canlı: supabase secrets set OPENAI_API_KEY=sk-... OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Ayşe Abla'nın sesi (kadın sesi: coral, nova ya da shimmer)
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Gece temizliği fonksiyonunu koruyan gizli değer (uzun ve rastgele olsun)
PURGE_CRON_SECRET=degistirin-uzun-rastgele-bir-deger
